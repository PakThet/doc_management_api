### Public routes

### Register
POST {{baseUrl}}/register
Content-Type: application/json

{
    "name": "John Doe",
    "email": "john@example.com",
    "password": "password",
    "password_confirmation": "password"
}

### Login Super Admin
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
    "email": "superadmin@acme.com",
    "password": "Password@123"
}

### Login Admin
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
    "email": "admin.acmehq@acme.com",
    "password": "Password@123"
}
### Login Staff User
POST {{baseUrl}}/auth/login
Content-Type: application/json
Accept: application/json

{
    "email": "staff.acmehq@acme.com",
    "password": "Password@123"
}

### Forgot password
POST {{baseUrl}}/forgot-password
Content-Type: application/json

{
    "email": "john@example.com"
}

### Reset password
POST {{baseUrl}}/reset-password
Content-Type: application/json

{
    "token": "reset-token",
    "email": "john@example.com",
    "password": "newpassword",
    "password_confirmation": "newpassword"
}

### Email verification (public link)
GET {{baseUrl}}/auth/verify-email/{id}/{hash}

### Document verify (public)
GET {{baseUrl}}/documents/verify/{{tokenDocVerify}}
Accept: application/json

### Protected routes (use Authorization header)

### Logout
POST {{baseUrl}}/auth/logout
Authorization: Bearer 
Accept: application/json

### Logout all sessions
POST {{baseUrl}}/auth/logout-all
Authorization: Bearer 
Accept: application/json

### Refresh token
GET {{baseUrl}}/auth/refresh
Authorization: Bearer 
Accept: application/json

### Current user
GET {{baseUrl}}/auth/me
Accept: application/json
Authorization: Bearer {{TokenSuperAdmin}}

### Update profile
PUT {{baseUrl}}/auth/profile
Authorization: Bearer 
Accept: application/json
Content-Type: application/json

{
    "first_name": "New",
    "last_name": "Name"
}

### Change password
POST {{baseUrl}}/auth/change-password
Authorization: Bearer 
Accept: application/json
Content-Type: application/json

{
    "current_password": "oldpass",
    "password": "newpass",
    "password_confirmation": "newpass"
}

### Toggle two‑factor
POST {{baseUrl}}/auth/two-factor/toggle
Authorization: Bearer 
Accept: application/json

### Resend verification email
POST {{baseUrl}}/auth/email/verification-notification
Authorization: Bearer 
Accept: application/json

### Users
GET {{baseUrl}}/users
Authorization: Bearer {{TokenSuperAdmin}}
Accept: application/json

### User Specific
GET {{baseUrl}}/users/23
Authorization: Bearer {{TokenSuperAdmin}}
Accept: application/json

### Create User
POST {{baseUrl}}/users
Authorization: Bearer {{TokenSuperAdmin}}
Accept: application/json
Content-Type: application/json

{
    "first_name": "Pak",
    "last_name": "Thet",
    "email": "pakthet@example.com",
    "password": "password",
    "password_confirmation": "password"
}

### Update User
PUT {{baseUrl}}/users/23
Authorization: Bearer {{TokenSuperAdmin}}
Accept: application/json
Content-Type: application/json

{
    "last_name": "Thet updated"
}

### Delete User
DELETE {{baseUrl}}/users/23
Authorization: Bearer {{TokenSuperAdmin}}
Accept: application/json

### Restore User
POST {{baseUrl}}/users/23/restore
Authorization: Bearer {{TokenSuperAdmin}}
Accept: application/json

### Assign Role
POST {{baseUrl}}/users/23/assign-role
Authorization: Bearer {{TokenSuperAdmin}}
Accept: application/json
Content-Type: application/json

{
    "role": "staff"
}

### Sync Permissions for User
POST {{baseUrl}}/users/23/sync-permissions
Authorization: Bearer {{TokenSuperAdmin}}
Accept: application/json
Content-Type: application/json

{
    "permissions": ["view users", "create users"]
}

### Available roles list for users
GET {{baseUrl}}/available-roles
Authorization: Bearer 
Accept: application/json

