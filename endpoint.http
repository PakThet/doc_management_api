### Public routes

### Register
POST {{baseUrl}}/register
Content-Type: application/json

{
    "name": "John Doe",
    "email": "john@example.com",
    "password": "password",
    "password_confirmation": "password"
}

### Login
POST {{baseUrl}}/login
Content-Type: application/json

{
    "email": "admin_1@example.com",
    "password": "password"
}

### Forgot password
POST {{baseUrl}}/forgot-password
Content-Type: application/json

{
    "email": "john@example.com"
}

### Reset password
POST {{baseUrl}}/reset-password
Content-Type: application/json

{
    "token": "reset-token",
    "email": "john@example.com",
    "password": "newpassword",
    "password_confirmation": "newpassword"
}

### Document verify (public)
GET {{baseUrl}}/documents/verify/{{token}}


### Protected routes (use Authorization header)

### Logout
POST {{baseUrl}}/logout
Authorization: Bearer {{authToken}}

### Me
GET {{baseUrl}}/me
Authorization: Bearer {{authToken}}

### Users
GET {{baseUrl}}/users
Authorization: Bearer {{authToken}}
Accept: application/json

GET {{baseUrl}}/users/{{id}}
Authorization: Bearer {{authToken}}

POST {{baseUrl}}/users
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "name": "Jane Doe",
    "email": "jane@example.com",
    "password": "password",
    "password_confirmation": "password"
}

PUT {{baseUrl}}/users/{{id}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "name": "Jane Updated"
}

DELETE {{baseUrl}}/users/{{id}}
Authorization: Bearer {{authToken}}

POST {{baseUrl}}/users/{{id}}/roles
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "roles": ["admin"]
}

