### Roles & Permissions
GET {{baseUrl}}/roles
Authorization: Bearer {{tokenStaff}}
Accept: application/json

###
POST {{baseUrl}}/roles
Accept: {{$aadToken}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "name": "manager"
}

###
PUT {{baseUrl}}/roles/{{id}}
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "name": "manager_updated"
}

###
DELETE {{baseUrl}}/roles/{{id}}
Authorization: Bearer {{authToken}}

###
POST {{baseUrl}}/roles/{{id}}/permissions
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
    "permissions": ["view users"]
}

